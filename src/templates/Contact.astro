---
import Layout from '../layouts/Layout.astro';
import { type CollectionEntry } from 'astro:content';
import { withBase } from '../utils/basePath';

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const { title, description, thumbnail } = entry.data;
const contactEmail = 'romy@romyjervis.com';
---

<Layout title={title} description={description}>
  <article class="contact-form page-template">
    {thumbnail && (
      <div class="post-content-image">
        <img src={withBase(thumbnail)} class="kg-image" alt={title} />
      </div>
    )}

    <div class="post-content-body">
      <section class="primary-zone">
        <div class="context">
          <p>
            Let’s connect. Whether you’re interested in a specific piece, a commission, or a collaborative project, I’m always open to new inquiries and conversations about form and clay.
          </p>
          <Content />
        </div>

        <div class="email-actions">
          <a href={`mailto:${contactEmail}`} class="email-link">
            {contactEmail}
          </a>
          <button id="copy-btn" class="copy-badge" data-email={contactEmail}>Copy</button>
        </div>
      </section>
    </div>
  </article>

  <script>
    function initCopyButton() {
      const copyButton = document.getElementById('copy-btn');
      if (!copyButton || copyButton.dataset.bound === 'true') return;
      copyButton.dataset.bound = 'true';

      copyButton.addEventListener('click', async () => {
        const email = copyButton.dataset.email;
        if (!email) return;

        await navigator.clipboard.writeText(email);
        copyButton.textContent = 'Copied';

        window.setTimeout(() => {
          copyButton.textContent = 'Copy';
        }, 1800);
      });
    }

    document.addEventListener('astro:page-load', initCopyButton);
  </script>

  <style>
    .primary-zone {
      display: flex;
      flex-direction: column;
      gap: 1.8rem;
      padding-bottom: 4vw;
    }

    .primary-zone h1 {
      margin: 0;
      color: var(--color-base);
    }

    .email-actions {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .email-link {
      color: var(--color-base);
      font-size: clamp(2.8rem, 6vw, 5.8rem);
      line-height: 1;
      overflow-wrap: anywhere;
      text-decoration-thickness: 0.08em;
      text-underline-offset: 0.12em;
    }

    .copy-badge {
      border: 1px solid var(--color-border);
      border-radius: 999px;
      background: var(--color-bg);
      box-shadow: inset 0 0 0 1px var(--color-border);
      color: var(--color-base) !important;
      cursor: pointer;
      font-family: var(--font-sans-serif);
      font-size: 1.3rem;
      font-weight: var(--font-normal);
      line-height: 1;
      padding: 0.8rem 1.2rem;
    }

    .copy-badge:hover {
      color: var(--color-bg) !important;
      background: var(--color-base);
      border-color: var(--color-base);
      box-shadow: inset 0 0 0 1px var(--color-base);
    }

    .context {
      max-width: 62rem;
    }

    .contact-form .post-content-image img {
      max-height: 400px;
      object-fit: cover;
    }
  </style>
</Layout>

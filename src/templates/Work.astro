---
import Layout from '../layouts/Layout.astro';
import { type CollectionEntry } from 'astro:content';
import { withBase } from '../utils/basePath';

interface Props {
  entry: CollectionEntry<'work'> | CollectionEntry<'news'> | CollectionEntry<'sold'>;
  next?: any;
  prev?: any;
  baseSlug?: string; // e.g. 'work'
}

const { entry, next, prev, baseSlug } = Astro.props;
const { Content } = await entry.render();

const { title, description, thumbnail, thumbnailDescription } = entry.data;

// Icons logic (replacing SVG imports with inline or similar)
// For simplicity, using text or simple arrows.
---

<Layout title={title} description={description}>
  <article class={`post-content ${thumbnail ? '' : 'no-image'}`}>
    {/* Title hidden as it is shown in the header now
    <header class="post-content-header">
      <h1 class="post-content-title">{title}</h1>
    </header>
    */}

    {thumbnail && (
      <figure class="post-content-image">
        <img src={withBase(thumbnail)} class="kg-image" alt={title} />
        {thumbnailDescription && (
          <figcaption class="top-image-caption">{thumbnailDescription}</figcaption>
        )}
      </figure>
    )}

    <div class="post-content-body">
      <Content />
    </div>

    <div class="post-link">
      <div>
        {next && (
            <a href={withBase(`/${baseSlug}/${next.slug}`)}>
               <span>&larr; {next.data.title}</span>
            </a>
        )}
      </div>
      <div>
        {prev && (
            <a href={withBase(`/${baseSlug}/${prev.slug}`)}>
               <span>{prev.data.title} &rarr;</span>
            </a>
        )}
      </div>
    </div>

  </article>

  <style>
    .top-image-caption {
      color: var(--color-base);
      font-size: 1.5rem;
      line-height: 1.4;
      margin: 0.6rem auto 0;
      max-width: 72rem;
      opacity: 0.72;
      text-align: center;
    }

    .post-content-body :global(p:has(> img)) {
      margin-bottom: 0;
    }

    .post-content-body :global(p:has(> img) + p) {
      color: var(--color-base);
      font-size: 1.5rem;
      line-height: 1.4;
      margin: 0.6rem auto 3vw;
      max-width: 72rem;
      opacity: 0.72;
      text-align: center;
    }
  </style>
</Layout>
